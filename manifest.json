{
  "manifest_version": 3,
  "name": "downskool",
  "version": "0.4.0",
  "description": "Descarga gratis los videos de tus cursos de Skool en MP4, MP3, M4A o WAV, con el texto de cada lección.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "downskool",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.skool.com/*",
    "https://*.mux.com/*",
    "https://*.loom.com/*",
    "https://*.vimeo.com/*",
    "https://*.vimeocdn.com/*",
    "https://*.akamaized.net/*",
    "https://*.wistia.com/*",
    "https://*.wistia.net/*",
    "https://*.cloudfront.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.skool.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
